views:
  - type: table
    name: Table
    filters:
      and:
        - file.inFolder("DND Vault/References/Rulebook/5.5e/Feats")
        - file.basename != "Feats"
    order:
      - file.name
      - file.folder
    sort:
      - property: file.folder
        direction: DESC
      - property: file.name
        direction: ASC
